// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Модели для веб-сайта
// Заказы создаются через backend API, поэтому здесь только модели для контента сайта

model News {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  imageUrl  String?  @map("image_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("news")
}

model Price {
  id        Int      @id @default(autoincrement())
  category  String
  name      String
  price     Decimal
  type      String   // 'service' or 'part'
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("prices")
  @@index([category])
  @@index([type])
}

model ForumTopic {
  id          Int          @id @default(autoincrement())
  title       String
  content     String
  author      String
  category    String
  views       Int          @default(0)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  replies     ForumReply[]

  @@map("forum_topics")
  @@index([category])
  @@index([createdAt(sort: Desc)])
}

model ForumReply {
  id        Int        @id @default(autoincrement())
  topicId   Int        @map("topic_id")
  content   String
  author    String
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  topic     ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@map("forum_replies")
  @@index([topicId])
  @@index([createdAt(sort: Desc)])
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_messages")
  @@index([createdAt(sort: Desc)])
}


